{
  "version": "aslam-gastric-v3",
  "model": "BernoulliNB (ASLAM, gejala biner, 4 kelas lambung)",
  "source": "ASLAM_NaiveBayes_FINAL_Revisi.ipynb",
  "task": "Klasifikasi Tipe Gangguan Lambung",
  "classes": [
    "Dispepsia",
    "GERD",
    "Gastritis",
    "Tukak Lambung"
  ],
  "base_features": [
    "stomach_pain",
    "acidity",
    "indigestion",
    "abdominal_pain",
    "belly_pain",
    "passage_of_gases",
    "diarrhoea",
    "bloody_stool",
    "irritation_in_anus",
    "pain_in_anal_region",
    "pain_during_bowel_movements",
    "high_fever",
    "chills",
    "toxic_look_(typhos)",
    "fatigue",
    "itching",
    "internal_itching",
    "headache",
    "ulcers_on_tongue",
    "cough"
  ],
  "engineered_features": [
    "GERD_Indicator",
    "Infection_Indicator",
    "Digestive_Distress",
    "Gastritis_Indicator"
  ],
  "feature_order": [
    "stomach_pain",
    "acidity",
    "indigestion",
    "abdominal_pain",
    "belly_pain",
    "passage_of_gases",
    "diarrhoea",
    "bloody_stool",
    "irritation_in_anus",
    "pain_in_anal_region",
    "pain_during_bowel_movements",
    "high_fever",
    "chills",
    "toxic_look_(typhos)",
    "fatigue",
    "itching",
    "internal_itching",
    "headache",
    "ulcers_on_tongue",
    "cough",
    "GERD_Indicator",
    "Infection_Indicator",
    "Digestive_Distress",
    "Gastritis_Indicator"
  ],
  "engineering": {
    "GERD_Indicator": "stomach_pain*acidity",
    "Infection_Indicator": "high_fever*chills",
    "Digestive_Distress": "abdominal_pain*passage_of_gases",
    "Gastritis_Indicator": "diarrhoea*belly_pain"
  },
  "alpha": 2.0,
  "confidence_threshold": 0.6,
  "single_symptom_confidence_threshold": 0.85,
  "core_gastric_symptoms": [
    "stomach_pain",
    "acidity",
    "indigestion",
    "abdominal_pain",
    "belly_pain",
    "passage_of_gases"
  ],
  "test_size": 0.2,
  "target_per_class": 250,
  "flip_prob": 0.07,
  "metrics": {
    "accuracy": 0.9835,
    "f1_macro": 0.9881,
    "f1_weighted": 0.9835,
    "cv_f1_macro": 0.9976
  },
  "sklearn_version": "1.9.0",
  "disclaimer": "Model gejala biner 4 kelas lambung (dataset Kaggle sintetis, bucket Normal dibuang sesuai revisi). Pra-diagnosa, bukan diagnosis medis. Model tidak memiliki kelas Normal sehingga tidak dapat menyatakan pasien sehat."
}