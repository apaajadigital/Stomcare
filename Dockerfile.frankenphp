# =====================================================================
#  StomaCare - Dockerfile UPGRADE (FrankenPHP) - konkurensi lebih baik
#  Untuk pakai: rename file ini menjadi "Dockerfile" (dan pastikan
#  docker-entrypoint-frankenphp.sh ada). Default proyek = Dockerfile (artisan serve).
#  Catatan: belum diuji-build lokal (mesin ini tanpa Docker) - uji saat deploy.
# =====================================================================
FROM dunglas/frankenphp:1-php8.4

# PHP extensions + Python
RUN install-php-extensions pdo_sqlite pdo_pgsql zip \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip git unzip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app
COPY . /app

RUN composer install --no-dev --optimize-autoloader --no-interaction --no-progress --no-scripts

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements-deploy.txt

ENV PYTHON_PATH=/opt/venv/bin/python \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr

RUN mkdir -p storage/framework/sessions storage/framework/views storage/framework/cache storage/logs bootstrap/cache database \
    && chmod -R 775 storage bootstrap/cache \
    && chmod +x docker-entrypoint-frankenphp.sh

EXPOSE 8080
CMD ["./docker-entrypoint-frankenphp.sh"]
